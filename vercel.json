{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/account/:path*",
      "destination": "https://oapi2.zyosoft.cn/account/:path*"
    },
    {
      "source": "/api/timeline/:path*",
      "destination": "https://oapi2.zyosoft.cn/sy-timeline/:path*"
    },
    {
      "source": "/api/license/:path*",
      "destination": "https://oapi2.zyosoft.cn/license/:path*"
    },
    {
      "source": "/api/checkin/:path*",
      "destination": "https://oapi2.zyosoft.cn/sy-checkin/:path*"
    },
    {
      "source": "/api/member/:path*",
      "destination": "https://oapi2.zyosoft.cn/member/:path*"
    },
    {
      "source": "/api/share/:path*",
      "destination": "https://oapi2.zyosoft.cn/share/:path*"
    },
    {
      "source": "/api/cloud/:path*",
      "destination": "https://oapi2.zyosoft.cn/sy-cloud-disk/:path*"
    },
    {
      "source": "/api/album/:path*",
      "destination": "https://oapi2.zyosoft.cn/sy-album/:path*"
    },
    {
      "source": "/media/ali/:path*",
      "destination": "https://ali-sybaby.zyosoft.cn/:path*"
    },
    {
      "source": "/media/qiniu/:path*",
      "destination": "https://qiniu-sybaby.zyosoft.cn/:path*"
    },
    {
      "source": "/media/appbaby/:path*",
      "destination": "https://qiniu.appbaby.net/:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
